# LOCAL: shu fayl nusxasini .env deb nomlang. Maxfiy ma’lumotlarni GitHub’ga yuklamang.
NODE_ENV=development
# Admin panel uchun o‘zingiz tanlagan uzun maxfiy kalit (32+ belgi)
ADMIN_KEY=OZINGIZGA_TEGISHLI_32_DAN_UZUN_MAXFIY_KALIT
# @AliDigitalHubOrdersBot tokeni BotFather'dan olinadi (bot username emas!)
TELEGRAM_BOT_TOKEN=
# Telegramda @AliDigitalHubOrdersBot ga /start yuborgandan keyin: npm run telegram:chatid
TELEGRAM_CHAT_ID=
# Renderda buyurtmalarni admin panelda saqlab ko‘rish uchun ixtiyoriy
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
